name: PR Check

on:
  pull_request:
    branches:
      - main
    types:
      - opened
      - synchronize

jobs:
  pr-check:
    runs-on: ubuntu-latest

    steps:
      - name: PR Branch
        run: echo "PR check running for branch: ${{ github.head_ref }}"

      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Show Repository Files
        run: ls -la
